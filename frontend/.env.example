PORT=3000

# App login (simple single-user auth)
APP_LOGIN_USERNAME=admin
APP_LOGIN_EMAIL=admin@clear.siem
APP_LOGIN_PASSWORD=admin123
APP_AUTH_TTL_HOURS=12
APP_DB_SCHEMA=ai

# App DB (same Postgres used by Agno, separate tables)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ai
DB_PASS=ai
DB_DATABASE=ai

# Optional: Wazuh/OpenSearch integration
OPENSEARCH_HOSTS=https://your-opensearch-host:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me
VERIFY_CERTS=false
OPENSEARCH_INDEX=wazuh-alerts-4.x-*
WAZUH_TOP_RULES_SIZE=10
WAZUH_TOP_RULES_LOOKBACK=24h
WAZUH_TOP_RULES_TIME_FIELD=timestamp

# Optional: Agent backend integration
AGENT_BACKEND_URL=http://127.0.0.1:8000
AGENT_WORKFLOW_ID=wazuh-fine-tuning-pipeline

# Optional backend auth
# AGENT_BACKEND_API_KEY=
# AGENT_BACKEND_BEARER_TOKEN=
